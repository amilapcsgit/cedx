<TextBlock Text="{Binding FilterValidation}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/><Button Content="Clear filters" Command="{Binding ResetFiltersCommand}" Style="{StaticResource Quiet}"/>
