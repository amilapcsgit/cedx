<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:Cedx.App.Common" x:Class="Cedx.App.MainWindow" Title="CEDX Asset Manager | cedxadnacedexe" Width="1540" Height="920" MinWidth="900" MinHeight="620" Background="#080D15">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <common:TileWidthConverter x:Key="TileWidth"/>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
      <Setter Property="Margin" Value="0,12,0,5"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="Compact" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Margin" Value="0,0,6,4"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Compact}">
      <Setter Property="Foreground" Value="#06121B"/>
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="#0C1522"/>
      <Setter Property="BorderBrush" Value="#284457"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="#142337" BorderBrush="#284457" BorderThickness="0,0,0,2" Padding="12,8">
              <ContentPresenter ContentSource="Header"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TileContainer" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Frame" BorderThickness="1" BorderBrush="#30465B" CornerRadius="10" Background="{StaticResource TileGlassBrush}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Frame" Property="Background" Value="#17323A"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Find" Executed="FindCommand_Executed"/>
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find"/>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
  </Window.InputBindings>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border BorderBrush="#294351" BorderThickness="0,0,0,1" Padding="4,0,0,10">
      <WrapPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
          <TextBlock Text="CEDX" FontFamily="Consolas" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
          <TextBlock Text=" / ASSET OPERATIONS" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{StaticResource SubtleTextBrush}" Margin="8,0,0,0"/>
        </StackPanel>
        <Button Content="Refresh / F5" Command="{Binding RefreshCommand}" Style="{StaticResource Compact}"/>
        <Button Content="Choose TXT folder" Command="{Binding ChooseFolderCommand}" Style="{StaticResource Compact}"/>
        <Button Content="Open folder" Command="{Binding OpenAssetsFolderCommand}" Style="{StaticResource Compact}"/>
        <Button Content="Export inventory" Command="{Binding ExportCsvCommand}" Style="{StaticResource Compact}"/>
        <Button Content="Export software" Command="{Binding ExportSoftwareCsvCommand}" Style="{StaticResource Compact}"/>
      </WrapPanel>
    </Border>
    <Expander Grid.Row="1" Header="WORKSPACE / appearance and layout" Foreground="{StaticResource SubtleTextBrush}" Margin="0,8">
      <WrapPanel Margin="8">
        <CheckBox Content="Show filters" IsChecked="{Binding ShowFilters}" VerticalAlignment="Center" Margin="0,0,20,0"/>
        <TextBlock Text="Accent" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox Width="150" ItemsSource="{Binding AccentOptions}" SelectedItem="{Binding Accent}" Margin="0,0,20,0"/>
        <TextBlock Text="Tile density" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Slider Width="170" Minimum="220" Maximum="440" Value="{Binding TileMinimumWidth}" TickFrequency="20" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,20,0"/>
        <Button Content="Reset layout" Command="{Binding ResetLayoutCommand}" Style="{StaticResource Compact}"/>
        <TextBlock Text="Drag the divider to resize the inspector. Layout saves on close." VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}"/>
      </WrapPanel>
    </Expander>
    <Grid x:Name="Workspace" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="FilterColumn" Width="220"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*" MinWidth="250"/>
        <ColumnDefinition x:Name="InspectorGapColumn" Width="8"/>
        <ColumnDefinition x:Name="InspectorColumn" Width="520" MinWidth="0"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition x:Name="InspectorGapRow" Height="0"/>
        <RowDefinition x:Name="InspectorRow" Height="0"/>
      </Grid.RowDefinitions>
      <Border Grid.Column="0" Grid.RowSpan="3" Background="#0E1B29" CornerRadius="8" Visibility="{Binding ShowFilters,Converter={StaticResource BoolVisibility}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <TextBlock Text="FILTER MATRIX" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="Operating system" Style="{StaticResource Label}"/>
            <ComboBox ItemsSource="{Binding OsOptions}" SelectedItem="{Binding SelectedOsFilter}"/>
            <TextBlock Text="Manufacturer" Style="{StaticResource Label}"/>
            <ComboBox ItemsSource="{Binding ManufacturerOptions}" SelectedItem="{Binding SelectedManufacturerFilter}"/>
            <TextBlock Text="Live status" Style="{StaticResource Label}"/>
            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatusFilter}"/>
            <TextBlock Text="AnyDesk ID" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding AnyDeskFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}"/>
            <TextBlock Text="RAM range / GB" Style="{StaticResource Label}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding MinRamFilterGb, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ToolTip="Minimum"/>
              <TextBox Grid.Column="2" Text="{Binding MaxRamFilterGb, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ToolTip="Maximum"/>
            </Grid>
            <TextBlock Text="C: free range / GB" Style="{StaticResource Label}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding MinStorageFilterGb, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ToolTip="Minimum"/>
              <TextBox Grid.Column="2" Text="{Binding MaxStorageFilterGb, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ToolTip="Maximum"/>
            </Grid>
            <CheckBox Content="Include missing measurements" IsChecked="{Binding IncludeUnknownMeasurements}" Margin="0,8,0,0"/>
            <CheckBox Content="Low C: free space" IsChecked="{Binding LowStorageOnly}" Margin="0,8,0,0"/>
            <CheckBox Content="Has AnyDesk ID" IsChecked="{Binding HasAnyDeskOnly}" Margin="0,8,0,0"/>
            <CheckBox Content="BitLocker protection off" IsChecked="{Binding HasBitLockerOffOnly}" Margin="0,8,0,0"/>
            <CheckBox Content="Has stored credentials" IsChecked="{Binding HasStoredCredentialsOnly}" Margin="0,8,0,0"/>
            <TextBlock Text="Low C: threshold / GB" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding LowStorageThresholdGb, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
            <TextBlock Text="{Binding FilterValidation}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <Button Content="Reset all filters" Command="{Binding ResetFiltersCommand}" Margin="0,12,0,0"/>
            <Separator Margin="0,18"/>
            <TextBlock Text="NETWORK / ON DEMAND" Style="{StaticResource Label}"/>
            <ComboBox ItemsSource="{Binding ScanTypeOptions}" SelectedItem="{Binding SelectedNmapScanType}"/>
            <TextBlock Text="Nmap executable" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding NmapPath, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Only the currently filtered IPs are scanned. Unknown is not proof of offline status." TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" Margin="0,8"/>
            <Button Content="Scan filtered assets" Command="{Binding ScanNetworkCommand}"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="2" x:Name="FleetPanel">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="SearchBox" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged,Delay=180}" ToolTip="Search all collected fields. Multiple terms use AND; quote an exact phrase. Ctrl+F" Padding="12,9"/>
          <Button Grid.Column="1" Content="Clear" Command="{Binding ClearSearchCommand}" Style="{StaticResource Compact}" Margin="6,0,0,0"/>
        </Grid>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
          <TextBlock Text="{Binding FilteredCount,StringFormat={}{0} ASSETS}" FontFamily="Consolas" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,4,18,4"/>
          <TextBlock Text="{Binding LowStorageCount,StringFormat={}{0} low C:}" Foreground="{StaticResource WarningBrush}" Margin="0,6,16,0"/>
          <TextBlock Text="{Binding TotalRamDisplay,StringFormat={}RAM {0}}" Margin="0,6,16,0"/>
          <ComboBox Width="160" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortMode}"/>
        </WrapPanel>
        <Grid Grid.Row="2">
          <TabControl>
            <TabItem Header="TILES">
              <ListBox x:Name="TilesList" ItemsSource="{Binding AssetsView}" SelectedItem="{Binding SelectedAsset,Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemContainerStyle="{StaticResource TileContainer}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="12">
                      <Grid.Width>
                        <MultiBinding Converter="{StaticResource TileWidth}">
                          <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                          <Binding Path="DataContext.FilteredCount" RelativeSource="{RelativeSource AncestorType=Window}"/>
                          <Binding Path="DataContext.TileMinimumWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                      </Grid.Width>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Text="{Binding Hostname}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hostname}"/>
                      <StackPanel Grid.Row="1" Margin="0,10,0,8">
                        <TextBlock Text="{Binding WindowsUserDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding WindowsAccount}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SubtleTextBrush}" ToolTip="{Binding WindowsAccount}"/>
                      </StackPanel>
                      <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition/>
                          <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding IpAddress}" FontFamily="Consolas" Foreground="{StaticResource AccentBlueBrush}"/>
                          <TextBlock Text="{Binding OsShortDisplay}"/>
                          <TextBlock Text="{Binding OnlineStatus,StringFormat={}Live: {0}}" Foreground="{StaticResource SubtleTextBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding RamDisplay,StringFormat={}RAM {0}}"/>
                          <TextBlock Text="{Binding CDriveFreeDisplay,StringFormat={}C: {0} free}"/>
                          <TextBlock Text="{Binding StorageHealthDisplay}">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding HasLowStorage}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </StackPanel>
                      </Grid>
                      <Button Grid.Row="3" Content="{Binding AnyDeskActionText}" Command="{Binding DataContext.LaunchAnyDeskCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding AnyDeskId}" Style="{StaticResource Primary}"/>
                      <WrapPanel Grid.Row="4">
                        <Button Content="Copy user" Command="{Binding DataContext.CopyTextCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding WindowsAccount}" Style="{StaticResource Compact}"/>
                        <Button Content="Copy IP" Command="{Binding DataContext.CopyTextCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding IpAddress}" Style="{StaticResource Compact}"/>
                      </WrapPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
            <TabItem Header="INVENTORY">
              <DataGrid ItemsSource="{Binding AssetsView}" SelectedItem="{Binding SelectedAsset,Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="180"/>
                  <DataGridTextColumn Header="Account" Binding="{Binding WindowsAccount}" Width="200"/>
                  <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="130"/>
                  <DataGridTextColumn Header="RAM GB" Binding="{Binding RamGb}"/>
                  <DataGridTextColumn Header="C: free GB" Binding="{Binding CDriveFreeGb,StringFormat=0.##}"/>
                  <DataGridTextColumn Header="AnyDesk" Binding="{Binding AnyDeskId}"/>
                  <DataGridTextColumn Header="OS" Binding="{Binding OsVersion}" Width="240"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
          </TabControl>
          <Border Visibility="{Binding HasNoResults,Converter={StaticResource BoolVisibility}}" Background="#E8101826" IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="NO MATCHING ASSETS" FontFamily="Consolas" FontSize="20" Foreground="{DynamicResource AccentBrush}"/>
              <TextBlock Text="Clear the search or reset the filters." Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <GridSplitter x:Name="InspectorDivider" Grid.Column="3" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#294351" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="InspectorDivider_DragCompleted"/>
      <Border x:Name="InspectorPanel" Grid.Column="4" BorderBrush="#294351" BorderThickness="1" CornerRadius="8" Background="#0D1725" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="ASSET INSPECTOR" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="{Binding SelectedAsset.Hostname,TargetNullValue=Select an asset}" FontSize="23" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,4"/>
            <TextBlock Text="{Binding SelectedAsset.WindowsAccount}" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding DetailSummary}" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4"/>
          </StackPanel>
          <WrapPanel Grid.Row="1" Margin="0,6,0,4">
            <Button Content="AnyDesk" Command="{Binding ConnectSelectedAnyDeskCommand}" Style="{StaticResource Primary}"/>
            <Button Content="Copy IP" Command="{Binding CopyTextCommand}" CommandParameter="{Binding SelectedAsset.IpAddress}" Style="{StaticResource Compact}"/>
            <Button Content="Copy WinRM" Command="{Binding CopyTextCommand}" CommandParameter="{Binding SelectedAsset.WinRmCommand}" Style="{StaticResource Compact}"/>
            <Button Content="Open original TXT" Command="{Binding OpenSourceCommand}" Style="{StaticResource Compact}"/>
          </WrapPanel>
          <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding DetailCategories}" SelectedItem="{Binding DetailCategory}"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding DetailSections}" SelectedItem="{Binding SelectedDetailSection}" DisplayMemberPath="DisplayName" ToolTip="All report sections, including collector extensions"/>
          </Grid>
          <TextBox Grid.Row="3" Text="{Binding DetailSearch,UpdateSourceTrigger=PropertyChanged,Delay=150}" ToolTip="Filter rows in the selected section by record, field or value" Margin="0,0,0,8"/>
          <TabControl Grid.Row="4">
            <TabItem Header="FIELDS">
              <DataGrid x:Name="DetailGrid" ItemsSource="{Binding DetailRows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="IncludeHeader" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Record}" Width="45"/>
                  <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="140"/>
                  <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" MinWidth="140">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="Padding" Value="4"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="SECTION">
              <TextBox Text="{Binding RawDetail,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </TabItem>
            <TabItem Header="SOURCE TXT">
              <TextBox Text="{Binding RawAsset,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </TabItem>
          </TabControl>
          <WrapPanel Grid.Row="5" Margin="0,8,0,0">
            <Button Content="Copy visible rows" Command="{Binding CopyDetailRowsCommand}" Style="{StaticResource Compact}"/>
            <Button Content="Export section CSV" Command="{Binding ExportDetailRowsCommand}" Style="{StaticResource Compact}"/>
            <CheckBox Content="Reveal license keys" IsChecked="{Binding RevealKeys}" VerticalAlignment="Center" Margin="4,0,12,0"/>
            <TextBlock Text="{Binding DetailRowCount}" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}"/>
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="3" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"/>
      <TextBlock Grid.Column="1" Text="{Binding LastRefreshText,StringFormat={}LAST SYNC / {0}}" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}"/>
    </Grid>
  </Grid>
</Window>
