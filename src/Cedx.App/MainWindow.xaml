<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:Cedx.App.Common" x:Class="Cedx.App.MainWindow" Style="{StaticResource {x:Type Window}}" UseLayoutRounding="True" SnapsToDevicePixels="True" Foreground="{StaticResource TextBrush}" Title="CEDX | Asset inventory" Width="1600" Height="960" MinWidth="1000" MinHeight="720" AllowDrop="True" Drop="Window_Drop">
  <Window.Resources>
    <common:DiskMeterConverter x:Key="DiskMeter"/>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <common:TileWidthConverter x:Key="TileWidth"/>
    <Style x:Key="Card" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Frame" Background="{StaticResource TileGlassBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding HasLowStorage}" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
              </DataTrigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Frame" Property="Background" Value="{StaticResource TileSelectedBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Quiet}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Padding" Value="10,10"/>
    </Style>
    <Style x:Key="MetricPanel" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource TileGlassBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
  </Window.Resources>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Find" Executed="FindCommand_Executed"/>
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find"/>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveAssetCommand}"/>
  </Window.InputBindings>
  <Grid x:Name="RootLayout" Margin="0" Background="{StaticResource WindowBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.RowSpan="4" IsHitTestVisible="False" ClipToBounds="True">
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="0.72" RadiusY="0.9">
            <GradientStop Color="#383F83B0" Offset="0"/>
            <GradientStop Color="#003F83B0" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="1,0.45" GradientOrigin="1,0.45" RadiusX="0.6" RadiusY="0.7">
            <GradientStop Color="#253F185A" Offset="0"/>
            <GradientStop Color="#003F185A" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>
    <Border Background="{StaticResource LiquidGlassBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="12,10,12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Width="42" Height="42" Background="#173D43" CornerRadius="8" Margin="0,0,12,0">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel>
            <TextBlock Text="CEDX" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="ASSET INVENTORY / LOCAL WORKSPACE" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" FontFamily="Consolas"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Import TXT files" Command="{Binding ImportFilesCommand}" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
          <Button Content="Import folder" Command="{Binding ChooseFolderCommand}" Margin="0,0,8,0"/>
          <Button Content="Refresh / F5" Command="{Binding RefreshCommand}" Style="{StaticResource Quiet}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Expander Grid.Row="1" Header="Workspace settings and data tools" Margin="12,0,12,10">
      <WrapPanel Margin="0,12">
        <TextBlock Text="Accent" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ComboBox Width="155" ItemsSource="{Binding AccentOptions}" SelectedItem="{Binding Accent}" Margin="0,0,16,0"/>
        <TextBlock Text="Card size" VerticalAlignment="Center"/>
        <Slider Minimum="240" Maximum="380" Width="130" Value="{Binding TileMinimumWidth}" VerticalAlignment="Center" Margin="10,0,16,0"/>
        <Button Content="Export inventory CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0"/>
        <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" Margin="0,0,8,0"/>
        <Button Content="Export software" Command="{Binding ExportSoftwareCsvCommand}" Margin="0,0,8,0"/>
        <Button Content="Backup database" Command="{Binding BackupCommand}" Margin="0,0,8,0"/>
        <Button Content="Reset layout" Command="{Binding ResetLayoutCommand}"/>
      </WrapPanel>
    </Expander>
    <Grid x:Name="Workspace" Grid.Row="2" Margin="0,0,10,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="216"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*" MinWidth="300"/>
        <ColumnDefinition x:Name="InspectorGapColumn" Width="14"/>
        <ColumnDefinition x:Name="InspectorColumn" Width="440"/>
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource SidebarGlassBrush}" CornerRadius="8" Padding="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="WORKSPACE" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,12"/>
            <Button Content="All assets" Command="{Binding ScopeCommand}" CommandParameter="All assets">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding InventoryScope}" Value="All assets">
                      <Setter Property="Background" Value="{StaticResource TileSelectedBrush}"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                      <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Command="{Binding ScopeCommand}" CommandParameter="Managed assets">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding InventoryScope}" Value="Managed assets">
                      <Setter Property="Background" Value="{StaticResource TileSelectedBrush}"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                      <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <TextBlock>
                <Run Text="Managed assets  ·  "/>
                <Run Text="{Binding ManagedCount,Mode=OneWay}"/>
              </TextBlock>
            </Button>
            <Button Command="{Binding ScopeCommand}" CommandParameter="Scan inbox">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding InventoryScope}" Value="Scan inbox">
                      <Setter Property="Background" Value="{StaticResource TileSelectedBrush}"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                      <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <TextBlock>
                <Run Text="Scan inbox  ·  "/>
                <Run Text="{Binding InboxCount,Mode=OneWay}"/>
              </TextBlock>
            </Button>
            <Button Command="{Binding ScopeCommand}" CommandParameter="Demo samples">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding InventoryScope}" Value="Demo samples">
                      <Setter Property="Background" Value="{StaticResource TileSelectedBrush}"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                      <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <TextBlock>
                <Run Text="Demo samples  ·  "/>
                <Run Text="{Binding DemoCount,Mode=OneWay}"/>
              </TextBlock>
            </Button>
            <Separator Margin="0,10"/>
            <TextBlock Text="Company" Style="{StaticResource Caption}"/>
            <ComboBox ItemsSource="{Binding CompanyOptions}" SelectedItem="{Binding CompanyFilter}"/>
            <TextBlock Text="Department" Style="{StaticResource Caption}"/>
            <ComboBox ItemsSource="{Binding DepartmentOptions}" SelectedItem="{Binding DepartmentFilter}"/>
            <TextBlock Text="Operating system" Style="{StaticResource Caption}"/>
            <ComboBox ItemsSource="{Binding OsOptions}" SelectedItem="{Binding SelectedOsFilter}"/>
            <CheckBox Content="Low disk space" IsChecked="{Binding LowStorageOnly}" Margin="0,15,0,5"/>
            <CheckBox Content="AnyDesk available" IsChecked="{Binding HasAnyDeskOnly}"/>
            <Expander Header="Advanced filters" Margin="0,14">
              <StackPanel>
                <TextBlock Text="Manufacturer" Style="{StaticResource Caption}"/>
                <ComboBox ItemsSource="{Binding ManufacturerOptions}" SelectedItem="{Binding SelectedManufacturerFilter}"/>
                <TextBlock Text="Min / max RAM GB" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding MinRamFilterGb,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                <TextBox Text="{Binding MaxRamFilterGb,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                <TextBlock Text="Min / max C: free GB" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding MinStorageFilterGb,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                <TextBox Text="{Binding MaxStorageFilterGb,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
                <CheckBox Content="Include unknown values" IsChecked="{Binding IncludeUnknownMeasurements}"/>
                <CheckBox Content="BitLocker off" IsChecked="{Binding HasBitLockerOffOnly}"/>
                <TextBlock Text="Low disk threshold GB" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding LowStorageThresholdGb,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
              </StackPanel>
            </Expander>
            <TextBlock Text="{Binding FilterValidation}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
            <Button Content="Clear filters" Command="{Binding ResetFiltersCommand}" Style="{StaticResource Quiet}"/>
            <Separator Margin="0,18"/>
            <TextBlock Text="SCAN SOURCE" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
            <TextBlock Text="{Binding AssetsFolderPath}" FontSize="12" TextWrapping="Wrap" Margin="0,8" ToolTip="{Binding AssetsFolderPath}"/>
            <CheckBox Content="Watch folder" IsChecked="{Binding WatchFolder}"/>
            <Button Content="Load demo samples" Command="{Binding LoadSamplesCommand}" Style="{StaticResource Quiet}" Margin="0,10,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid x:Name="FleetPanel" Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding InventoryScope}" FontSize="26" FontWeight="SemiBold"/>
          <Button Grid.Column="1" Content="Asset details" Command="{Binding ToggleInspectorCommand}" Style="{StaticResource Quiet}"/>
        </Grid>
        <WrapPanel Grid.Row="1" Margin="0,0,0,15">
          <TextBlock Text="{Binding FilteredCount,StringFormat={}{0} visible}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>
          <TextBlock Text="{Binding LoadedCount,StringFormat={}{0} stored}" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,12,0"/>
          <TextBlock Text="{Binding LowStorageCount,StringFormat={}{0} low disk}" Foreground="{StaticResource WarningBrush}"/>
        </WrapPanel>
        <Grid Grid.Row="2" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid>
            <TextBox x:Name="SearchBox" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged,Delay=180}" Padding="12,9" MinHeight="40"/>
            <TextBlock Text="Search hostname, owner, company, software..." Foreground="{StaticResource SubtleTextBrush}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SearchText}" Value="">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <ComboBox Grid.Column="1" Width="135" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortMode}" Margin="8,0,0,0"/>
        </Grid>
        <Grid Grid.Row="4">
          <TabControl x:Name="FleetTabs">
            <TabItem Header="CARDS">
              <ListBox x:Name="TilesList" ItemsSource="{Binding AssetsView}" SelectedItem="{Binding SelectedAsset,Mode=TwoWay}" ItemContainerStyle="{StaticResource Card}" ScrollViewer.VerticalScrollBarVisibility="Auto" IsSynchronizedWithCurrentItem="False">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="16">
                      <Grid.Width>
                        <MultiBinding Converter="{StaticResource TileWidth}">
                          <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                          <Binding Path="DataContext.FilteredCount" RelativeSource="{RelativeSource AncestorType=Window}"/>
                          <Binding Path="DataContext.TileMinimumWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                      </Grid.Width>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}"/>
                        <Border Grid.Column="1" Background="#24374C" CornerRadius="3" Padding="7,3">
                          <TextBlock Text="{Binding ManagementDisplay}" FontFamily="Consolas" FontSize="11" Foreground="#AFC8D7"/>
                        </Border>
                      </Grid>
                      <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Hostname}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hostname}"/>
                        <TextBlock Text="{Binding OwnerDisplay}" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OrganizationDisplay}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                      <Grid Grid.Row="2" Margin="0,10,0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition/>
                          <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="IP ADDRESS" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                          <TextBlock Text="{Binding IpAddress}" FontFamily="Consolas" FontSize="13" Margin="0,3" Foreground="{StaticResource AccentBlueBrush}"/>
                          <TextBlock Text="{Binding OsShortDisplay}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                          <TextBlock Text="{Binding AnyDeskActionText}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding AnyDeskId}" Margin="0,4,0,0">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding HasAnyDesk}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentPinkBrush}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding RamDisplay,StringFormat={}RAM  {0}}" FontSize="12"/>
                          <TextBlock Text="{Binding CDriveTileDisplay,StringFormat={}C: free  {0}}" FontSize="12" Margin="0,3" FontWeight="SemiBold">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding HasLowStorage}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <TextBlock Text="{Binding StorageHealthDisplay}" FontSize="12">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding HasLowStorage}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </StackPanel>
                      </Grid>
                      <ProgressBar Grid.Row="3" Value="{Binding Converter={StaticResource DiskMeter},Mode=OneWay}" Visibility="{Binding Converter={StaticResource DiskMeter},ConverterParameter=Visibility}" Maximum="100" Margin="0,3,0,8" ToolTip="C: free space as a percentage of reported capacity">
                        <ProgressBar.Style>
                          <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasLowStorage}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ProgressBar.Style>
                      </ProgressBar>
                      <Grid Grid.Row="4" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Open asset" Command="{Binding DataContext.OpenAssetCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="AnyDesk" Command="{Binding DataContext.LaunchAnyDeskCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding AnyDeskId}"/>
                      </Grid>
                      <Grid Grid.Row="5" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition/>
                          <ColumnDefinition Width="8"/>
                          <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Copy user" Command="{Binding DataContext.CopyTextCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding WindowsAccount}" Style="{StaticResource Quiet}" MinHeight="28" Padding="8,3" FontSize="12" ToolTip="{Binding WindowsAccount}"/>
                        <Button Grid.Column="2" Content="Copy IP" Command="{Binding DataContext.CopyTextCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding IpAddress}" Style="{StaticResource Quiet}" MinHeight="28" Padding="8,3" FontSize="12" ToolTip="{Binding IpAddress}"/>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
            <TabItem Header="TABLE">
              <DataGrid x:Name="InventoryGrid" ItemsSource="{Binding AssetsView}" SelectedItem="{Binding SelectedAsset,Mode=TwoWay}" SelectionMode="Single" IsSynchronizedWithCurrentItem="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="160"/>
                  <DataGridTextColumn Header="Owner" Binding="{Binding OwnerDisplay}" Width="150"/>
                  <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="130"/>
                  <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="130"/>
                  <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="130"/>
                  <DataGridTextColumn Header="RAM GB" Binding="{Binding RamGb}" Width="85"/>
                  <DataGridTextColumn Header="C: free GB" Binding="{Binding CDriveFreeGb}" Width="95"/>
                  <DataGridTextColumn Header="State" Binding="{Binding ManagementDisplay}" Width="100"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
          </TabControl>
          <Border Background="#EA0C1624" Visibility="{Binding HasNoResults,Converter={StaticResource BoolVisibility}}" Margin="0,45,0,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="No matching assets" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="Clear filters or import a TXT scan to get started." Margin="0,10,0,20" Foreground="{StaticResource SubtleTextBrush}"/>
              <Button Content="Clear filters" Command="{Binding ResetFiltersCommand}"/>
              <Button Content="Import TXT files" Command="{Binding ImportFilesCommand}" Style="{StaticResource Primary}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
        <Expander Grid.Row="5" Header="{Binding LastImportSummary}" Margin="0,10,0,0" MaxHeight="220">
          <DataGrid ItemsSource="{Binding ImportResults}" MaxHeight="180">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90"/>
              <DataGridTextColumn Header="File" Binding="{Binding File}" Width="220"/>
              <DataGridTextColumn Header="Detail" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Expander>
        <UniformGrid x:Name="FleetMetrics" Grid.Row="3" Columns="4" Margin="0,0,0,12">
          <Border Style="{StaticResource MetricPanel}">
            <StackPanel>
              <DockPanel>
                <Path Width="16" Height="16" Data="M2,2 H18 V13 H2 Z M6,17 H14 M10,13 V17" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,8,0"/>
                <TextBlock Text="REMOTE ACCESS" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
              </DockPanel>
              <TextBlock Text="{Binding AnyDeskReadyCount,StringFormat={}{0} IDs available}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,3"/>
              <TextBlock Text="Availability not tested" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource MetricPanel}">
            <StackPanel>
              <DockPanel>
                <Path Width="16" Height="16" Data="M10,1 L19,17 H1 Z M10,6 V11 M10,13 V14" Stroke="{StaticResource WarningBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,8,0"/>
                <TextBlock Text="LOW DISK SPACE" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
              </DockPanel>
              <TextBlock Text="{Binding LowStorageCount,StringFormat={}{0} alerts}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,5,0,3"/>
              <TextBlock Text="{Binding VisibleStorageCoverage}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource MetricPanel}">
            <StackPanel>
              <DockPanel>
                <Path Width="16" Height="16" Data="M1,4 H19 V15 H1 Z M4,7 V12 M8,7 V12 M12,7 V12 M16,7 V12 M4,15 V18 M8,15 V18 M12,15 V18 M16,15 V18" Stroke="{StaticResource AccentBlueBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,8,0"/>
                <TextBlock Text="INSTALLED MEMORY" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
              </DockPanel>
              <TextBlock Text="{Binding TotalRamDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,5,0,3"/>
              <TextBlock Text="{Binding VisibleHardwareCoverage}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource MetricPanel}" Margin="0">
            <StackPanel>
              <TextBlock Text="OPERATING SYSTEMS" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
              <ScrollViewer MaxHeight="65" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding OsSegments}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="26"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
                          <ProgressBar Value="{Binding Percent,Mode=OneWay}" Maximum="100" Foreground="{StaticResource AccentBlueBrush}" Height="3" Margin="0,3,0,2" ToolTip="{Binding Percent,StringFormat={}{0:0.#}% of visible assets}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Count}" HorizontalAlignment="Right" FontSize="12"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </UniformGrid>
      </Grid>
      <GridSplitter x:Name="InspectorDivider" Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#22374D" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="InspectorDivider_DragCompleted"/>
      <Border x:Name="InspectorPanel" Grid.Column="4" Background="{StaticResource DetailsGlassBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="ASSET WORKSPACE" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
              <TextBlock Text="{Binding SelectedAsset.Hostname,TargetNullValue=Select an asset}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
              <TextBlock Text="{Binding SelectedAsset.ManagementDisplay}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4"/>
            </StackPanel>
            <Button Grid.Column="1" Content="✕" Command="{Binding ToggleInspectorCommand}" Style="{StaticResource Quiet}" VerticalAlignment="Top"/>
          </Grid>
          <WrapPanel Grid.Row="1" Margin="0,12,0,8">
            <Button Content="Manage asset" Command="{Binding ManageAssetCommand}" Style="{StaticResource Primary}" Margin="0,0,6,6"/>
            <Button Content="Copy IP" Command="{Binding CopyTextCommand}" CommandParameter="{Binding SelectedAsset.IpAddress}" Style="{StaticResource Quiet}" Margin="0,0,6,6"/>
            <Button Content="AnyDesk" Command="{Binding ConnectSelectedAnyDeskCommand}" Style="{StaticResource Quiet}" Margin="0,0,0,6"/>
          </WrapPanel>
          <TabControl x:Name="InspectorTabs" Grid.Row="2" SelectedIndex="{Binding InspectorTab}">
            <TabItem Header="Overview">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <Grid Margin="0,4,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#1A3040" Padding="12" CornerRadius="5">
                      <StackPanel>
                        <TextBlock Text="MEMORY" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedAsset.RamDisplay}" FontSize="24" FontWeight="SemiBold" Margin="0,5"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#1D2C41" Padding="12" CornerRadius="5">
                      <StackPanel>
                        <TextBlock Text="C: FREE SPACE" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedAsset.CDriveTileDisplay}" FontSize="24" FontWeight="SemiBold" Margin="0,5"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                  <TextBlock Text="Assignment" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Person" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedAsset.OwnerDisplay}" TextWrapping="Wrap"/>
                  <TextBlock Text="Company / department" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedAsset.OrganizationDisplay}" TextWrapping="Wrap"/>
                  <TextBlock Text="Windows account" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedAsset.WindowsAccount}" TextWrapping="Wrap"/>
                  <TextBlock Text="Asset tag" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedAsset.AssetTag}" TextWrapping="Wrap"/>
                  <TextBlock Text="Location" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedAsset.Location}" TextWrapping="Wrap"/>
                  <TextBlock Text="Hardware and system" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Manufacturer / model" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedAsset.Model}" TextWrapping="Wrap"/>
                  <TextBlock Text="Serial number" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedAsset.SerialNumber}" TextWrapping="Wrap"/>
                  <TextBlock Text="Operating system" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedAsset.OsVersion}" TextWrapping="Wrap"/>
                  <TextBlock Text="CPU" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedAsset.Cpu}" TextWrapping="Wrap"/>
                  <TextBlock Text="Graphics" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedAsset.Gpu}" TextWrapping="Wrap"/>
                  <TextBlock Text="Antivirus" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedAsset.Antivirus}" TextWrapping="Wrap"/>
                  <TextBlock Text="Network address" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedAsset.IpAddress}" TextWrapping="Wrap"/>
                  <TextBlock Text="Gateway" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedAsset.Network.DefaultGateway}" TextWrapping="Wrap"/>
                  <TextBlock Text="DNS" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedAsset.Network.DnsServers}" TextWrapping="Wrap"/>
                  <TextBlock Text="Storage volumes" Style="{StaticResource SectionTitle}"/>
                  <ItemsControl ItemsSource="{Binding SelectedAsset.LocalDisks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                          <StackPanel>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding DriveLetter}" FontWeight="Bold" Margin="0,0,12,0"/>
                              <TextBlock Text="{Binding FreeGb,StringFormat={}{0:0.#} GB free}"/>
                              <TextBlock Text="{Binding TotalGb,StringFormat={} / {0:0.#} GB}" Foreground="{StaticResource SubtleTextBrush}"/>
                            </StackPanel>
                            <ProgressBar Value="{Binding Converter={StaticResource DiskMeter},Mode=OneWay}" Visibility="{Binding Converter={StaticResource DiskMeter},ConverterParameter=Visibility}" Maximum="100" Margin="0,8,0,0" ToolTip="Free space / reported capacity"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Collection notes" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="{Binding DetailSummary}" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"/>
                  <ItemsControl ItemsSource="{Binding SelectedAsset.ParseWarnings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,5"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Expander Header="Remote diagnostics" Margin="0,18">
                    <StackPanel>
                      <Button Content="Copy WinRM command" Command="{Binding CopyTextCommand}" CommandParameter="{Binding SelectedAsset.WinRmCommand}"/>
                      <TextBlock Text="Nmap executable" Style="{StaticResource Caption}"/>
                      <TextBox Text="{Binding NmapPath}"/>
                      <ComboBox ItemsSource="{Binding ScanTypeOptions}" SelectedItem="{Binding SelectedNmapScanType}" Margin="0,8"/>
                      <Button Content="Scan filtered assets" Command="{Binding ScanNetworkCommand}"/>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Manage">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel IsEnabled="{Binding HasSelection}">
                    <TextBlock Text="Asset assignment" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,8"/>
                    <TextBlock Text="Assign responsibility and location. Future scans keep these fields." Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="Company" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding EditCompany,UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Person / assigned to" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding EditPerson,UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Department" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding EditDepartment,UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Location / room" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding EditLocation,UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Asset tag" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding EditTag,UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Lifecycle" Style="{StaticResource Caption}"/>
                    <ComboBox ItemsSource="{Binding Lifecycles}" SelectedItem="{Binding EditLifecycle}"/>
                    <TextBlock Text="Notes" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding EditNotes,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalContentAlignment="Top"/>
                  </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                  <TextBlock Text="{Binding DraftStatus}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                  <Button Content="{Binding SaveAssetLabel}" Command="{Binding SaveAssetCommand}" Style="{StaticResource Primary}"/>
                  <Button Content="Discard changes" Command="{Binding DiscardDraftCommand}" Style="{StaticResource Quiet}" Margin="0,8,0,0"/>
                </StackPanel>
              </Grid>
            </TabItem>
            <TabItem Header="Scan data">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ComboBox ItemsSource="{Binding DetailCategories}" SelectedItem="{Binding DetailCategory}" Margin="0,0,0,7"/>
                <ComboBox Grid.Row="1" ItemsSource="{Binding DetailSections}" SelectedItem="{Binding SelectedDetailSection}" DisplayMemberPath="DisplayName" Margin="0,0,0,7"/>
                <TextBox Grid.Row="2" Text="{Binding DetailSearch,UpdateSourceTrigger=PropertyChanged,Delay=150}" ToolTip="Search fields and values in this section" Margin="0,0,0,7"/>
                <TabControl Grid.Row="3">
                  <TabItem Header="Fields">
                    <DataGrid x:Name="DetailGrid" ItemsSource="{Binding DetailRows}" ClipboardCopyMode="IncludeHeader">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Record}" Width="55"/>
                        <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="130"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" MinWidth="120">
                          <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                              <Setter Property="TextWrapping" Value="Wrap"/>
                              <Setter Property="Padding" Value="5"/>
                            </Style>
                          </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                  </TabItem>
                  <TabItem Header="Raw TXT">
                    <TextBox Text="{Binding RawAsset,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                  </TabItem>
                </TabControl>
                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                  <CheckBox Content="Reveal license keys for selected asset" IsChecked="{Binding RevealKeys}"/>
                  <WrapPanel>
                    <Button Content="Copy fields" Command="{Binding CopyDetailRowsCommand}" Style="{StaticResource Quiet}" Margin="0,0,6,6"/>
                    <Button Content="Export section" Command="{Binding ExportDetailRowsCommand}" Style="{StaticResource Quiet}" Margin="0,0,6,6"/>
                    <Button Content="Export TXT" Command="{Binding ExportReportCommand}" Style="{StaticResource Quiet}"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding DetailRowCount}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12"/>
                </StackPanel>
              </Grid>
            </TabItem>
            <TabItem Header="History">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="Saved scan revisions" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Repeated identical scans are not duplicated. Older scans stay in history without replacing the latest data." TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,12"/>
                  <ItemsControl ItemsSource="{Binding ScanHistory}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                          <StackPanel>
                            <TextBlock Text="{Binding Date}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Source}" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,6"/>
                            <Button Content="Open saved snapshot" Command="{Binding DataContext.ViewHistoryCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource Quiet}" HorizontalAlignment="Left"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="3" Margin="10,8,10,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/>
      <TextBlock Grid.Column="1" Text="LOCAL DATABASE" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" ToolTip="{Binding DatabasePath}" Margin="18,0,0,0"/>
    </Grid>
  </Grid>
</Window>
