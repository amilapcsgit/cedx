<Window x:Class="Cedx.App.AstraWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CEDX · Astra mission control" Style="{StaticResource {x:Type Window}}" Width="1600" Height="960" MinWidth="1000" MinHeight="720" Background="#080F1C" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style x:Key="Rail" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Padding" Value="12,12"/></Style>
  <Style x:Key="PanelTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Result" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Shell" Background="#111D2E" BorderBrush="#294055" BorderThickness="1" CornerRadius="10"><Grid><Border x:Name="Stripe" Width="3" Background="Transparent" HorizontalAlignment="Left" Margin="0,9"/><ContentPresenter Margin="17,12"/></Grid></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Shell" Property="Background" Value="#12313B"/><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Stripe" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#64B5FF"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Window.InputBindings><KeyBinding Key="F5" Command="{Binding RefreshCommand}"/><KeyBinding Key="Enter" Modifiers="Control" Command="{Binding Inspector.ConnectSelectedAnyDeskCommand}"/><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveAssignmentCommand}"/></Window.InputBindings>
 <Grid x:Name="AstraRoot" Background="#080F1C">
  <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#101E30" BorderBrush="#2B4157" BorderThickness="0,0,0,1"><Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" Background="#153F47" CornerRadius="8" Margin="0,0,12,0"><Path Data="M16,2 L29,26 H3 Z M16,10 V20 M11,20 H21" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Width="24" Height="24" Stretch="Uniform"/></Border><TextBlock Text="ASTRA" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text=" / CEDX    MISSION CONTROL" FontFamily="Consolas" Foreground="#9EB4CB" FontSize="12" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Review folder" Command="{Binding ChooseFolderCommand}" Margin="0,0,8,0"/><Button Content="Export results" Command="{Binding ExportCommand}" Style="{StaticResource Quiet}" Margin="0,0,8,0"/><Button Content="Refresh · F5" Command="{Binding RefreshCommand}" Style="{StaticResource Quiet}"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1" x:Name="AstraWorkspace"><Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition x:Name="DetailsGap" Width="16"/><ColumnDefinition x:Name="DetailsColumn" Width="440"/></Grid.ColumnDefinitions>
   <Border Background="#0D1929" Padding="12,22,12,12"><DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="SOURCE FOLDER" Style="{StaticResource PanelTitle}"/><TextBlock Text="{Binding SourceFolder}" TextWrapping="Wrap" FontSize="11" Foreground="#B4C5D9" MaxHeight="80" ToolTip="{Binding SourceFolder}"/><Button Content="Choose folder" Command="{Binding ChooseFolderCommand}" Style="{StaticResource Quiet}" Margin="0,12,0,12"/><Expander Header="Appearance / backup"><StackPanel Margin="0,10"><ComboBox ItemsSource="{Binding Inspector.AccentOptions}" SelectedItem="{Binding Inspector.Accent}"/><Button Content="Backup database" Command="{Binding BackupCommand}" Margin="0,8,0,0"/></StackPanel></Expander><TextBlock Text="LOCAL WORKSPACE" Style="{StaticResource PanelTitle}" Margin="0,16,0,0"/></StackPanel>
    <StackPanel><TextBlock Text="OPERATIONS" Style="{StaticResource PanelTitle}"/>
     <Button Command="{Binding ScopeCommand}" CommandParameter="Current assets"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Rail}"><Style.Triggers><DataTrigger Binding="{Binding Scope}" Value="Current assets"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="#173A43"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><TextBlock Text="Current assets" FontWeight="SemiBold"/><TextBlock Text="{Binding CurrentCount,StringFormat={}{0} records}" FontSize="11" Foreground="#AFC3D9" Margin="0,4,0,0"/></StackPanel></Button>
     <Button Command="{Binding ScopeCommand}" CommandParameter="Review TXT"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Rail}"><Style.Triggers><DataTrigger Binding="{Binding Scope}" Value="Review TXT"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="#173A43"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><TextBlock Text="Review TXT" FontWeight="SemiBold"/><TextBlock Text="{Binding ReviewCount,StringFormat={}{0} records}" FontSize="11" Foreground="#AFC3D9" Margin="0,4,0,0"/></StackPanel></Button>
     <Button Command="{Binding ScopeCommand}" CommandParameter="Archived"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Rail}"><Style.Triggers><DataTrigger Binding="{Binding Scope}" Value="Archived"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="#173A43"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><TextBlock Text="Archived" FontWeight="SemiBold"/><TextBlock Text="{Binding ArchiveCount,StringFormat={}{0} records}" FontSize="11" Foreground="#AFC3D9" Margin="0,4,0,0"/></StackPanel></Button>
     <Button Command="{Binding ScopeCommand}" CommandParameter="Demo"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Rail}"><Style.Triggers><DataTrigger Binding="{Binding Scope}" Value="Demo"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="#173A43"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><TextBlock Text="Demo workspace" FontWeight="SemiBold"/></StackPanel></Button>
     <Separator Margin="0,14"/><TextBlock Text="QUICK FILTERS" Style="{StaticResource PanelTitle}"/>
     <CheckBox Content="Has AnyDesk ID" IsChecked="{Binding RemoteOnly}" Margin="0,3,0,10"/><CheckBox Content="Duplicate TXT only" IsChecked="{Binding DuplicatesOnly}" IsEnabled="{Binding IsReview}"/>
     <Button Content="Clear search / filters" Command="{Binding ClearCommand}" Style="{StaticResource Quiet}" Margin="0,16,0,0"/>
     <TextBlock Text="Ctrl+F   Find person&#10;Ctrl+Enter   AnyDesk&#10;Ctrl+S   Save assignment" FontFamily="Consolas" FontSize="11" Foreground="#9EB4CB" LineHeight="22" Margin="0,24,0,0"/>
    </StackPanel>
   </DockPanel></Border>
   <Grid Grid.Column="2" x:Name="ResultWorkspace" Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Scope}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding ScopeHint}" Foreground="#AFC3D9" FontSize="12" Margin="0,5,0,14" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Inspector" Command="{Binding OpenDetailsCommand}" Style="{StaticResource Quiet}" VerticalAlignment="Top" Margin="8,0,0,0"/></Grid>
    <Border Grid.Row="1" Background="#111F31" BorderBrush="#4D7C90" BorderThickness="1" CornerRadius="10" Padding="14,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="⌕" Foreground="{DynamicResource AccentBrush}" FontSize="28" VerticalAlignment="Center"/><Grid Grid.Column="1"><TextBox x:Name="AstraSearch" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged,Delay=150}" FontSize="19" Padding="0,6" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Find person, computer, account or email" KeyDown="Search_KeyDown"/><TextBlock Text="Person, computer, account, email or any scan text" Foreground="#91AAC3" FontSize="16" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button Grid.Column="2" Content="×" Command="{Binding ClearCommand}" Style="{StaticResource Quiet}" BorderThickness="0" Padding="6" Margin="8,0,0,0" ToolTip="Clear search and filters"/></Grid></Border>
    <WrapPanel Grid.Row="2" Margin="0,12,0,12"><TextBlock Text="{Binding ResultCount}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding ReadyCount,StringFormat=   /   {0} remote IDs}" Foreground="#C9D7E7"/><TextBlock Text="{Binding OlderCount,StringFormat=   /   {0} TXT older than 90d}" Foreground="#FFC857" ToolTip="Source file modification age, not live device status"/></WrapPanel>
    <Grid Grid.Row="3"><ListBox x:Name="AstraResults" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected,Mode=TwoWay}" ItemContainerStyle="{StaticResource Result}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" IsSynchronizedWithCurrentItem="False"><ListBox.ItemTemplate><DataTemplate>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding Person}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Person}"/><WrapPanel Margin="0,5,0,0"><TextBlock Text="{Binding Asset.Hostname}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,14,0"/><TextBlock Text="{Binding Asset.WindowsAccount}" Foreground="#BDD0E6"/></WrapPanel><TextBlock Text="{Binding Emails}" Foreground="#64B5FF" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Emails}"/>
       <WrapPanel Margin="0,5,0,0"><TextBlock Text="{Binding Asset.IpAddress}" Foreground="#64B5FF" Margin="0,0,14,0"/><TextBlock Text="{Binding Asset.OsShortDisplay}" Margin="0,0,14,0" FontSize="12"/><TextBlock Text="{Binding Asset.RamDisplay,StringFormat=RAM {0}}" FontSize="12"/></WrapPanel>
       <TextBlock Text="{Binding Evidence}" TextTrimming="CharacterEllipsis" Foreground="#AFC3D9" FontSize="12" Margin="0,5,0,0" ToolTip="{Binding Evidence}"/><TextBlock Text="{Binding State}" FontFamily="Consolas" FontSize="11" Foreground="#FFC857" Margin="0,7,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Asset.AnyDeskId}" Foreground="#FF7ED0" FontFamily="Consolas" FontSize="15" HorizontalAlignment="Right" Margin="0,0,0,8"/><Button Content="Connect AnyDesk" Command="{Binding DataContext.Inspector.LaunchAnyDeskCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Asset.AnyDeskId}" Style="{StaticResource Primary}" ToolTip="{Binding Asset.Hostname,StringFormat=Connect to {0}}"/><Button Content="Inspect PC" Command="{Binding DataContext.OpenDetailsCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource Quiet}" Margin="0,7,0,0"/><TextBlock Text="{Binding FileAge}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileAge}" FontSize="10" Foreground="#9EB4CB" Margin="0,8,0,0"/></StackPanel>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border Background="#101C2B" Padding="24" VerticalAlignment="Top"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Results.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="No matching computers" FontSize="21"/><TextBlock Text="Clear filters, review a TXT folder or open the demo workspace." TextWrapping="Wrap" Foreground="#AFC3D9" Margin="0,10,0,16"/><Button Content="Review a folder" Command="{Binding ChooseFolderCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left"/></StackPanel></Border></Grid>
    <Expander Grid.Row="4" Header="Source file issues" Margin="0,8" MaxHeight="150"><TextBox Text="{Binding FileErrors,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="110" VerticalScrollBarVisibility="Auto"/></Expander>
   </Grid>
   <Border x:Name="AstraInspector" Grid.Column="4" Background="#111D2E" BorderBrush="#2B4157" BorderThickness="1,0,0,0" Padding="18,20,18,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SELECTED COMPUTER" Style="{StaticResource PanelTitle}"/><TextBlock Text="{Binding Selected.Asset.Hostname,TargetNullValue=Select a result}" FontSize="23" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Selected.Person}" Foreground="{DynamicResource AccentBrush}" FontSize="16" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="×" Click="CloseDetails_Click" Style="{StaticResource Quiet}" VerticalAlignment="Top"/></Grid>
    <TextBlock Grid.Row="1" Text="{Binding SelectionHint}" Foreground="#AFC3D9" FontSize="12" TextWrapping="Wrap" Margin="0,12"/>
    <WrapPanel Grid.Row="2" Margin="0,0,0,10"><Button Content="AnyDesk" Command="{Binding Inspector.ConnectSelectedAnyDeskCommand}" Style="{StaticResource Primary}" Margin="0,0,6,6"/><Button Content="Copy account" Command="{Binding Inspector.CopyTextCommand}" CommandParameter="{Binding Selected.Asset.WindowsAccount}" Style="{StaticResource Quiet}" Margin="0,0,6,6"/><Button Content="Copy IP" Command="{Binding Inspector.CopyTextCommand}" CommandParameter="{Binding Selected.Asset.IpAddress}" Style="{StaticResource Quiet}" Margin="0,0,0,6"/></WrapPanel>
    <TabControl Grid.Row="3" x:Name="AstraTabs">
     <TabItem Header="Overview"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Inspector.OverviewGroups}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8,0,8"><TextBlock Text="{Binding Title}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" FontSize="12" Foreground="#AFC3D9" TextWrapping="Wrap" Margin="0,3,8,0"/><TextBox Grid.Column="1" Text="{Binding Value,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" MinHeight="0" Padding="0,3"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
     <TabItem Header="Manage"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,0"><TextBlock Text="Assignment / current inventory" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Approve a reviewed TXT before editing its assignment." TextWrapping="Wrap" Foreground="#AFC3D9" Margin="0,8,0,12"/>
      <StackPanel IsEnabled="{Binding CanManage}">
<TextBlock Text="Company" Style="{StaticResource Caption}"/><TextBox Text="{Binding Inspector.EditCompany,UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="Person / assigned to" Style="{StaticResource Caption}"/><TextBox Text="{Binding Inspector.EditPerson,UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="Department" Style="{StaticResource Caption}"/><TextBox Text="{Binding Inspector.EditDepartment,UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="Location / room" Style="{StaticResource Caption}"/><TextBox Text="{Binding Inspector.EditLocation,UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="Asset tag" Style="{StaticResource Caption}"/><TextBox Text="{Binding Inspector.EditTag,UpdateSourceTrigger=PropertyChanged}"/>
       <TextBlock Text="Notes" Style="{StaticResource Caption}"/><TextBox Text="{Binding Inspector.EditNotes,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto"/><TextBlock Text="{Binding Inspector.DraftStatus}" TextWrapping="Wrap" Foreground="#FFC857" Margin="0,12"/>
       <Button Content="Save assignment · Ctrl+S" Command="{Binding SaveAssignmentCommand}" Style="{StaticResource Primary}"/><WrapPanel Margin="0,10"><Button Content="Archive asset" Command="{Binding ArchiveCommand}" Style="{StaticResource Quiet}" Margin="0,0,6,0"/><Button Content="Restore asset" Command="{Binding RestoreCommand}" Style="{StaticResource Quiet}"/></WrapPanel>
      </StackPanel></StackPanel></ScrollViewer></TabItem>
     <TabItem Header="TXT files"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,0"><TextBlock Text="Review before approval" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Use Review TXT to rename, correct or remove source files. Removing a TXT does not delete a saved asset." TextWrapping="Wrap" Foreground="#AFC3D9" Margin="0,8,0,12"/><TextBlock Text="{Binding Selected.State}" Foreground="#FFC857" TextWrapping="Wrap"/><TextBlock Text="{Binding Selected.Asset.SourceFilePath}" TextWrapping="Wrap" FontSize="12" Foreground="#AFC3D9" Margin="0,8,0,16"/>
      <Button Content="Approve this report → inventory" Command="{Binding ApproveCommand}" Style="{StaticResource Primary}"/><TextBlock Text="Filename (including .txt)" Style="{StaticResource Caption}"/><TextBox Text="{Binding Filename,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanModify}"/>
      <Button Content="Rename TXT" Command="{Binding RenameCommand}" Margin="0,8,0,16"/><Button Content="Edit TXT with backup…" Command="{Binding EditCommand}"/><TextBlock Text="Edits remain in review until approved. Original bytes are kept in a .bak file." TextWrapping="Wrap" FontSize="12" Foreground="#AFC3D9" Margin="0,8,0,18"/>
      <Button Content="Remove TXT (recoverable)" Command="{Binding RemoveCommand}" Style="{StaticResource Quiet}"/><Button Content="Undo last TXT removal" Command="{Binding UndoRemoveCommand}" Style="{StaticResource Quiet}" Margin="0,8,0,0"/>
      <TextBlock Text="Approval uses the existing hostname, domain and serial matching rules. Older reports become history and do not replace newer scans. No automatic duplicate deletion." TextWrapping="Wrap" Foreground="#AFC3D9" FontSize="12" Margin="0,20,0,0"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Scan data"><Grid Margin="0,10,0,0" DataContext="{Binding Inspector}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ComboBox ItemsSource="{Binding DetailSections}" SelectedItem="{Binding SelectedDetailSection}" DisplayMemberPath="DisplayName"/><TextBox Grid.Row="1" Text="{Binding DetailSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter technical fields" Margin="0,8"/><DataGrid Grid.Row="2" ItemsSource="{Binding DetailRows}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="130"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="3" Margin="0,10,0,0"><CheckBox Content="Reveal keys for this selected computer" IsChecked="{Binding RevealKeys}"/><WrapPanel Margin="0,8,0,0"><Button Content="Copy fields" Command="{Binding CopyDetailRowsCommand}" Style="{StaticResource Quiet}"/><Button Content="Export fields" Command="{Binding ExportDetailRowsCommand}" Style="{StaticResource Quiet}" Margin="6,0,0,0"/></WrapPanel></StackPanel></Grid></TabItem>
    </TabControl>
   </Grid></Border>
  </Grid>
  <Border Grid.Row="2" Background="#0D1929" Padding="12,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" FontSize="11" Foreground="#BDD0E6" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/><TextBlock Grid.Column="1" Text="LOCAL / REVIEWED INVENTORY" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0" ToolTip="{Binding DatabasePath}"/></Grid></Border>
  <ProgressBar Grid.Row="0" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource Visible}}"/>
 </Grid>
</Window>
