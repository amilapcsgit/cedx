      <TextBlock Grid.Row="2" Text="{Binding Asset.WindowsAccount}" FontSize="11" Foreground="#BED1DD" TextTrimming="CharacterEllipsis" ToolTip="{Binding Asset.WindowsAccount}"/>
      <Grid Grid.Row="3" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Asset.OsShortDisplay}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Asset.IpAddress}" FontSize="12" Foreground="#78CEE7" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Asset.RamDisplay,StringFormat=RAM {0}}" FontSize="12"/><TextBlock Text="{Binding Asset.CDriveTileDisplay,StringFormat=C: free {0}}" FontSize="12" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DAE8EE"/><Style.Triggers><DataTrigger Binding="{Binding Asset.HasLowStorage}" Value="True"><Setter Property="Foreground" Value="#FFC857"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Grid>
