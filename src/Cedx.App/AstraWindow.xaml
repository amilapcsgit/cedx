      <StackPanel Grid.Row="7" Margin="0,8,0,0"><TextBlock Text="{Binding State}" Foreground="#E5C98C" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding State}"/><TextBlock Text="{Binding Evidence}" FontSize="11" Foreground="#A9BFCB" TextTrimming="CharacterEllipsis" ToolTip="{Binding Evidence}"/></StackPanel>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate></ListBox>
