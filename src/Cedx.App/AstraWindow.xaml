<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:Cedx.App.Common" x:Class="Cedx.App.AstraWindow" Title="CEDX · Astra mission control" Style="{StaticResource {x:Type Window}}" Width="1600" Height="960" MinWidth="1000" MinHeight="720" Background="#07151F" UseLayoutRounding="True" SnapsToDevicePixels="True">
