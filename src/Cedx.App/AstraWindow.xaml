    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Shell" Property="Background" Value="#143C41"/><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Stripe" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#64B5FF"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers>
