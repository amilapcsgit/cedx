       <Button Content="Save assignment · Ctrl+S" Command="{Binding SaveAssignmentCommand}" Style="{StaticResource Primary}"/><WrapPanel Margin="0,10"><Button Content="Archive asset" Command="{Binding ArchiveCommand}" Style="{StaticResource Quiet}" Margin="0,0,6,0"/><Button Content="Restore asset" Command="{Binding RestoreCommand}" Style="{StaticResource Quiet}"/></WrapPanel>
      </StackPanel></StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Files"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,0"><TextBlock Text="Review before approval" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Use Review TXT to rename, correct or remove source files. Removing a TXT does not delete a saved asset." TextWrapping="Wrap" Foreground="#AFC3D9" Margin="0,8,0,12"/><TextBlock Text="{Binding Selected.State}" Foreground="#FFC857" TextWrapping="Wrap"/><TextBlock Text="{Binding Selected.FileAge}" Foreground="#AFC3D9" FontSize="12" Margin="0,8,0,0"/><TextBlock Text="{Binding Selected.Asset.SourceFilePath}" TextWrapping="Wrap" FontSize="12" Foreground="#AFC3D9" Margin="0,8,0,16"/>
      <Button Content="Approve this report → inventory" Command="{Binding ApproveCommand}" Style="{StaticResource Primary}"/><TextBlock Text="Filename (including .txt)" Style="{StaticResource Caption}"/><TextBox Text="{Binding Filename,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanModify}"/>
      <Button Content="Rename TXT" Command="{Binding RenameCommand}" Margin="0,8,0,16"/><Button Content="Edit TXT with backup…" Command="{Binding EditCommand}"/><TextBlock Text="Edits remain in review until approved. Original bytes are kept in a .bak file." TextWrapping="Wrap" FontSize="12" Foreground="#AFC3D9" Margin="0,8,0,18"/>
      <Button Content="Remove TXT (recoverable)" Command="{Binding RemoveCommand}" Style="{StaticResource Quiet}"/><Button Content="Undo last TXT removal" Command="{Binding UndoRemoveCommand}" Style="{StaticResource Quiet}" Margin="0,8,0,0"/>
      <TextBlock Text="Approval uses the existing hostname, domain and serial matching rules. Older reports become history and do not replace newer scans. No automatic duplicate deletion." TextWrapping="Wrap" Foreground="#AFC3D9" FontSize="12" Margin="0,20,0,0"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Data"><Grid Margin="0,10,0,0" DataContext="{Binding Inspector}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ComboBox ItemsSource="{Binding DetailSections}" SelectedItem="{Binding SelectedDetailSection}" DisplayMemberPath="DisplayName"/><TextBox Grid.Row="1" Text="{Binding DetailSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter technical fields" Margin="0,8"/><DataGrid Grid.Row="2" ItemsSource="{Binding DetailRows}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="130"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="3" Margin="0,10,0,0"><CheckBox Content="Reveal keys for this selected computer" IsChecked="{Binding RevealKeys}"/><WrapPanel Margin="0,8,0,0"><Button Content="Copy fields" Command="{Binding CopyDetailRowsCommand}" Style="{StaticResource Quiet}"/><Button Content="Export fields" Command="{Binding ExportDetailRowsCommand}" Style="{StaticResource Quiet}" Margin="6,0,0,0"/></WrapPanel></StackPanel></Grid></TabItem>
     <TabItem Header="History"><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Saved scan revisions. Archiving keeps this history." TextWrapping="Wrap" Foreground="#AFC3D9" Margin="0,0,0,10"/><DataGrid Grid.Row="1" ItemsSource="{Binding Inspector.ScanHistory}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Collected / modified" Binding="{Binding Date}" Width="150"/><DataGridTextColumn Header="Source TXT" Binding="{Binding Source}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
    </TabControl>
   </Grid></Border>
  </Grid>
  <Border Grid.Row="2" Background="#0D202B" Padding="12,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" FontSize="11" Foreground="#BDD0E6" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/><TextBlock Grid.Column="1" Text="LOCAL / REVIEWED INVENTORY" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0" ToolTip="{Binding DatabasePath}"/></Grid></Border>
  <ProgressBar Grid.Row="0" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource Visible}}"/>
 </Grid>
</Window>
