    </StackPanel>
   <StackPanel><TextBlock Text="SOURCE FOLDER" Style="{StaticResource PanelTitle}"/><TextBlock Text="{Binding SourceFolder}" TextWrapping="Wrap" FontSize="11" Foreground="#B4C5D9" MaxHeight="80" ToolTip="{Binding SourceFolder}"/><Button Content="Choose folder" Command="{Binding ChooseFolderCommand}" Style="{StaticResource Quiet}" Margin="0,12,0,12"/>
